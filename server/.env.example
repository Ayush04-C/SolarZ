PORT=5000
MONGO_URI=mongodb://localhost:27017/local-goods-marketplace
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
CLIENT_URL=http://localhost:5173

# AI Recommendations Configuration
# To use a different provider (e.g., BharatCode, Groq, OpenRouter):
# - Set AI_BASE_URL to their API endpoint (typically ends in /v1)
# - Set AI_MODEL to the model they expect
# - Set AI_API_KEY to your API key from their dashboard
# To disable AI recommendations and use the fallback, set AI_RECOMMENDATIONS_ENABLED=false
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_RECOMMENDATIONS_ENABLED=true
